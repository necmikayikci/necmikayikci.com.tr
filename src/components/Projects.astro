---
import Icon from './Icon.astro';
import { projects } from '../content';
---

<section id="projeler" aria-labelledby="projeler-baslik">
  <div class="wrap">
    <div class="head">
      <h2 class="title" id="projeler-baslik">Üzerinde çalıştığım projeler</h2>
      <p class="sub">Uygulamaların dışında geliştirdiğim, bir kısmı henüz yolda olan ürünler.</p>
    </div>
    <div class="grid">
      {
        projects.map((p) => (
          <article class="card" id={p.id}>
            <div class="top">
              <div class="badge" aria-hidden="true"><Icon name={p.icon} /></div>
              <span class="state">{p.state}</span>
            </div>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
            <ul class="tech" aria-label="Teknolojiler">
              {p.tech.map((t) => <li>{t}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section { padding: 96px 0 0; scroll-margin-top: 16px; }
  .head { text-align: center; margin-bottom: 44px; }
  .title { font-size: clamp(34px, 4.4vw, 52px); line-height: 1.06; }
  .sub { max-width: 520px; margin: 14px auto 0; font-size: 18px; color: var(--ink-70); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .card { background: var(--cream); border-radius: var(--r-md); padding: 32px; display: flex; flex-direction: column; min-height: 320px; scroll-margin-top: 16px; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .state { font-size: 13px; font-weight: 500; background: var(--page); border-radius: 999px; padding: 6px 14px; }
  h3 { font-size: 28px; line-height: 1.1; margin-top: 40px; }
  p { margin-top: 10px; color: var(--ink-70); font-size: 16px; }
  .tech { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 28px; }
  .tech li { font-size: 13px; font-weight: 500; border: 1px solid var(--cream-2); background: var(--page); border-radius: 999px; padding: 6px 12px; }

  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    section { padding-top: 72px; }
    .grid { grid-template-columns: 1fr; }
    .card { padding: 26px 22px; min-height: 0; }
    h3 { margin-top: 28px; }
  }
</style>
