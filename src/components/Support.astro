---
import Icon from './Icon.astro';
import { faq, inline } from '../content';
import { site } from '../config';
---

<section id="destek" aria-labelledby="destek-baslik">
  <div class="wrap support">
    <div class="intro">
      <div class="badge" aria-hidden="true"><Icon name="help" /></div>
      <h2 id="destek-baslik">Destek</h2>
      <p class="lead">Kurulumda takıldıysanız ya da bir hata bulduysanız buraya göz atın. Cevabı bulamazsanız bana yazın.</p>
      <a class="btn btn-green" href={site.mailto('Destek')}><Icon name="mail" />Destek için yazın</a>
      <p class="hint">Uygulama adını, sürümünü ve cihazınızı (ör. “MacBook Air M2, macOS 15”) yazarsanız çok daha hızlı çözebilirim.</p>
    </div>
    <div class="qa">
      {
        faq.map((g) => (
          <div class="group">
            <h3>{g.app}</h3>
            {g.items.map((it) => (
              <details>
                <summary>{it.q}</summary>
                <p set:html={inline(it.a)} />
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  section { padding: 96px 0 0; scroll-margin-top: 16px; }
  .support { display: grid; grid-template-columns: 5fr 7fr; gap: 48px; align-items: start; }
  .intro { position: sticky; top: 24px; }
  h2 { font-size: clamp(34px, 4.4vw, 52px); line-height: 1.05; margin-top: 22px; }
  .lead { font-size: 18px; color: var(--ink-70); margin: 16px 0 28px; max-width: 420px; }
  .hint { margin-top: 18px; font-size: 14px; color: var(--ink-muted); max-width: 400px; }
  .group + .group { margin-top: 32px; }
  h3 { font-size: 15px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--green); margin-bottom: 12px; font-family: var(--body); }
  details { background: var(--cream); border-radius: var(--r-sm); }
  details + details { margin-top: 8px; }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 60px; padding: 14px 22px; font-weight: 600; font-size: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-size: 24px; font-weight: 400; color: var(--green); transition: transform .2s; flex: none; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding: 0 22px 20px; color: var(--ink-70); font-size: 15px; }
  details p :global(strong) { color: var(--ink); font-weight: 600; }

  @media (max-width: 1000px) {
    .support { grid-template-columns: 1fr; gap: 32px; }
    .intro { position: static; }
  }
  @media (max-width: 640px) {
    section { padding-top: 72px; }
    summary { padding: 14px 18px; font-size: 15px; }
    details p { padding: 0 18px 18px; }
  }
</style>
